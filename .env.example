# ===== Required =====
DATABASE_URL=postgres://user:pass@host:5432/voyageo
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=https://voyageo.app

# ===== Email (Resend) — required for password reset, welcome, trip share =====
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Voyageo <noreply@voyageo.app>

# ===== AI generation (Anthropic) — optional, AI features disabled if missing =====
ANTHROPIC_API_KEY=sk-ant-xxx

# ===== Payments (Stripe) — optional, paid plans disabled if missing =====
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_SOLO_MONTHLY=price_xxx
STRIPE_PRICE_SOLO_YEARLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_AGENCY_MONTHLY=price_xxx
STRIPE_PRICE_AGENCY_YEARLY=price_xxx

# ===== Weather (Meteoblue) — optional =====
METEOBLUE_API_KEY=

# ===== Admin =====
# One-time reset: set this and the super admin password will be reset on next boot.
# Remove after first boot.
SUPER_ADMIN_RESET_PASSWORD=

# ===== Object Storage =====
# Cover photo uploads are disabled outside Replit by default.
# To enable on Replit, set REPLIT_OBJECT_STORAGE_ENABLED=1 and PUBLIC_OBJECT_SEARCH_PATHS / PRIVATE_OBJECT_DIR.
# Off Replit, leave unset.
